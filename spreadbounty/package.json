{
  "name": "spreadbounty",
  "private": true,
  "type": "module",
  "description": "Verifiable maker-depth incentives for Kuru order books on Monad",
  "scripts": {
    "sb": "tsx src/cli/main.ts",
    "test": "tsx test/core.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "demo:gen": "tsx src/demo/generate.ts",
    "test:ai": "npm run --silent demo:gen && tsx test/ai.test.ts",
    "serve": "tsx src/server/index.ts",
    "dev": "vite web",
    "build:web": "vite build web",
    "start": "npm run demo:gen && npm run build:web && npm run serve",
    "mock:llm": "tsx test/mock-llm.ts",
    "bot": "tsx src/bot/main.ts",
    "test:bot": "npm run --silent demo:gen && tsx test/bot.test.ts",
    "fakechain": "tsx test/fake-chain.ts",
    "drop:compile": "tsx src/drop/compile.ts",
    "drop": "tsx src/drop/main.ts",
    "test:drop": "npm run --silent demo:gen && tsx test/drop.test.ts",
    "localchain": "tsx test/local-chain.ts",
    "test:all": "npm test && npm run test:boundary && npm run test:ai && npm run test:bot && npm run test:drop && npm run test:server",
    "test:boundary": "tsx test/boundary.test.ts",
    "test:server": "npm run --silent demo:gen && tsx test/server.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "dotenv": "16.4.5",
    "ethers": "5.8.0",
    "motion": "13.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@1inch/solidity-utils": "6.9.16",
    "@openzeppelin/contracts": "5.4.0",
    "@types/node": "22.13.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "ganache": "7.9.2",
    "solc": "0.8.23",
    "tsx": "4.16.2",
    "typescript": "5.5.3",
    "vite": "8.3.1"
  }
}
