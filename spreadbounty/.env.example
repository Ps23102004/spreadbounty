# Copy to .env. Never commit .env.
# Data: demo (default, synthetic) or live (Monad mainnet)
DATA_SOURCE=demo
# RPC_URL=https://rpc.monad.xyz

# AI: claude | local | off  (default: claude if ANTHROPIC_API_KEY is set, else local if LOCAL_LLM_MODEL is set, else off)
# AI_PROVIDER=local
# LOCAL_LLM_URL=http://localhost:11434/v1
# LOCAL_LLM_MODEL=gemma3:4b
# ANTHROPIC_API_KEY=

# Maker bot (live mode only). A FRESH THROWAWAY wallet holding only what you can lose.
# BOT_KEY=
# BOT_MAX_ORDER_QUOTE=100

# Claim contract (npm run drop). The sponsor's key: it owns the distributor and funds it.
# SPONSOR_KEY=
# CLAIM_KEY=        (optional: a separate key that only pays gas to push claims)

# Public server (plans/SECURITY-PLAN.md). Names only; never commit values.
# PUBLIC_DEMO=1              tighter caps (50 campaigns in total) and server AI off unless SERVER_AI=on
# SERVER_AI=off              on | off. off ignores ANTHROPIC_API_KEY / LOCAL_LLM_* for server-side AI
# TRUST_PROXY=1              number of reverse proxies in front (client IP and https come from their headers); 0 = none
# CSP_CONNECT_EXTRA=         extra connect-src origins for browser model calls, space separated (e.g. http://192.168.1.20:8000)
