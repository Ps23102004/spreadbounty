# Monad mainnet. The public RPC caps eth_getLogs at 100 blocks and ~50 req/s.
RPC_URL=https://rpc.monad.xyz

# Two throwaway wallets. NEVER use a wallet that holds real funds.
# Each needs >= 12 MON (Monad keeps a ~10 MON reserve; the rest is gas).
# MAKER needs ~12 AUSD + ~12 USDC; TAKER needs ~6 USDC.
MAKER_KEY=0x...
TAKER_KEY=0x...

# Market under test. Default: Kuru AUSD/USDC (empty book, per the perpl_basis_trade fork study).
MARKET=0x8cF49e35D73B19433FF4d4421637AABB680dc9Cc
# Fallback if AUSD/USDC fails: Kuru MON/USDC
# MARKET=0x065C9d28E428A0db40191a54d33d5b7c71a9C394

# Reference price the band is centred on. Leave empty to use the live mid (needed for MON/USDC).
REF_PRICE=1.0
# Maker quotes at REF*(1 -/+ BAND_BPS). Campaign band for scoring is SCORE_BAND_BPS.
BAND_BPS=5
SCORE_BAND_BPS=15
# Order size in base units (raised to the market's minSize if smaller).
ORDER_SIZE=10
# Taker spends this much quote (USDC) buying against our ask.
TAKER_QUOTE=5
